    {"name": "Key", "min": 0, "max": 11, "default": 0, "type": "int", "learnable": false},
    {"name": "Scale", "min": 0, "max": 1, "default": 0, "type": "int", "learnable": false},
    {"name": "Prog", "min": 0, "max": 7, "default": 0, "type": "int", "learnable": false},
    {"name": "Rate", "min": 0, "max": 128, "default": 0, "type": "int", "learnable": false},
    {"name": "Octave", "min": 2, "max": 6, "default": 4, "type": "int", "learnable": false},
    {"name": "Sevenths", "min": 0, "max": 1, "default": 0, "type": "int", "learnable": false},
    {"name": "Instr", "min": 0, "max": 64, "default": 0, "type": "int", "learnable": false},
    {"name": "Mode", "min": 0, "max": 2, "default": 0, "type": "int", "learnable": false}
  ],
  "views": [
    {"name": "Body", "min_size": [480, 288], "preferred_size": [800, 384]}
  ],
  "voices": 1,
  "memory": {"hot_bytes": 0, "sdram_bytes": 0}
